{
  "name": "hall-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:fix-review-ratings": "prisma db execute --file prisma/convert-review-ratings.sql --schema prisma/schema.prisma",
    "db:sync": "prisma migrate deploy && prisma generate",
    "db:studio": "prisma studio",
    "db:wipe-all": "prisma db execute --file prisma/wipe-all-app-data.sql --schema prisma/schema.prisma",
    "geocode:venues": "node scripts/geocode-venues.mjs",
    "seed:packages": "node scripts/seed-event-packages.mjs",
    "seed:venues": "node scripts/seed-sample-venues.mjs",
    "seed:venues:fix-images": "node scripts/seed-sample-venues.mjs --fix-images",
    "seed:services": "node scripts/seed-sample-services.mjs",
    "seed:services:fix-images": "node scripts/seed-sample-services.mjs --fix-images",
    "seed:rebuild-all": "node scripts/seed-sample-venues.mjs --rebuild && node scripts/seed-sample-services.mjs --rebuild",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:stop": "powershell -NoProfile -Command \"$ErrorActionPreference='SilentlyContinue'; Get-NetTCPConnection -LocalPort 3000 -State Listen | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }; Start-Sleep -Milliseconds 400; if (Test-Path '.next/dev/lock') { Remove-Item -Force '.next/dev/lock' }\"",
    "build": "node scripts/migrate-deploy-with-retry.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "dev:all": "npm run dev:stop && concurrently \"npm run dev\" \"npx prisma studio --port 5555 --browser none\" \"powershell -NoProfile -Command \\\"Start-Sleep -Seconds 2; Start-Process 'http://localhost:5555'\\\"\""
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@sentry/nextjs": "^10.69.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.6.1",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "next": "16.2.12",
    "prisma": "5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

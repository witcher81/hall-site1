// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // ברירת מחדל: node_modules/.prisma/client — מומלץ על Windows/OneDrive כדי למנוע EPERM על query_engine בנתיב מותאם
}

// Connection string only via process env — never hardcode credentials in the repo.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String?
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         String   @default("SEEKER")
  /// אימות כתובת אימייל — משתמשים חדשים מתחילים עם false
  emailVerified Boolean @default(false)
  /// JSON: העדפות מייל { inquiryReply, newInquiry, serviceRequestReply, newServiceRequest }
  emailNotificationsJson String?
  /// חסימת משתמש על ידי אדמין
  isBlocked Boolean @default(false)
  // פרופיל עסקי לבעל אולם / ספק שירותים
  businessName    String?
  businessPhone   String?
  businessAddress String?
  /// JSON: מערך { platform, url } לרשתות חברתיות (פרילנסרים)
  socialLinksJson String?
  venues        Venue[]
  services      Service[]
  inquiriesSent     Inquiry[]
  serviceRequestsSent ServiceRequest[]
  negotiationOffers   NegotiationOffer[]
  favorites         Favorite[]
  venueReviews      VenueReview[]
  serviceReviews    ServiceReview[]
  conversationsAsP1 Conversation[] @relation("ConvP1")
  conversationsAsP2 Conversation[] @relation("ConvP2")
  messagesSent      Message[]
  eventPlans        EventPlan[]
  seekerEventBundles SeekerEventBundle[]
  notifications     Notification[]
  freelancerProfileViews FreelancerProfileView[]
  managedUsersAsAdmin   DevManagedUser[] @relation("AdminManagedUsers")
  managedByAdmins       DevManagedUser[] @relation("ManagedByAdmins")
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  serviceFavorites      ServiceFavorite[]
  contentReports        ContentReport[]
  payments              Payment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// טוקני איפוס סיסמה — נשמר רק hash, חד פעמי, עם תוקף
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// קודי אימות אימייל (OTP) — נשמר רק hash, חד פעמי, עם תוקף
model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  codeHash  String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// שיוך משתמשי "החלף משתמש" לאדמין שיצר אותם
model DevManagedUser {
  id            Int      @id @default(autoincrement())
  adminUserId   Int
  managedUserId Int
  createdAt     DateTime @default(now())

  admin   User @relation("AdminManagedUsers", fields: [adminUserId], references: [id], onDelete: Cascade)
  managed User @relation("ManagedByAdmins", fields: [managedUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, managedUserId])
  @@index([adminUserId])
  @@index([managedUserId])
}

model Venue {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  city        String
  address     String
  minGuests   Int?
  maxGuests   Int?
  minPrice    Int?
  maxPrice    Int?
  /// טווח מחיר השכרת האולם (לאירוע) – ₪
  hallRentalMin Int?
  hallRentalMax Int?
  description String?
  // JSON string של סוגי אירועים שהאולם מתאים אליהם
  eventTypes  String?
  /// JSON: לכל סוג אירוע טווח אורחים + טווח מחירי מנה (נפרד)
  eventTypeProfilesJson String?
  // מאפיינים מתקדמים לחיפוש
  kashrut     String?  // למשל: "ללא", "רגיל", "מהדרין"
  parking     String?  // למשל: "אין", "חניה צמודה", "חניון"
  venueType   String?  // סוג מקום — ערך מוגדר מראש או שם מותאם («אחר»)
  seaView     Boolean? // נוף לים
  boutique    Boolean? // מתאים לאירועי בוטיק
  accessible  Boolean? // נגישות לנכים
  // מאפייני שירות/ציוד באולם (לסינון ולקבלת החלטה)
  hasChuppa      Boolean @default(false)
  hasFood        Boolean @default(false)
  hasDanceFloor  Boolean @default(false)
  hasTableSetup  Boolean @default(false)
  hasSoundSystem Boolean @default(false)
  /// רישיון אקו"ם להשמעת מוזיקה באירוע — תמחור ב-customAmenitiesJson
  hasAcumLicense Boolean @default(false)
  hasBridalRoom  Boolean @default(false)
  /// JSON: מערך { label, checked } — שירותים/ציוד נוספים שהבעלים הוסיף
  customAmenitiesJson String?
  /// JSON: מערך { id, label, on } — מאפיינים מילוליים ללא תמחור (מותאמים אישית)
  venueSoftAttributesJson String?
  hasChuppaOutdoor Boolean @default(false)
  hasChuppaCovered Boolean @default(false)
  hasVeganFood     Boolean @default(false)
  coverImageUrl     String?
  galleryImageUrls  String? // JSON string of string[]
  latitude          Float?
  longitude         Float?
  /// יש חניה באזור — כשמסומן, אפשר לשמור מיקום נפרד במפה (סיכת חניה)
  hasParkingNearby  Boolean @default(false)
  /// none | adjacent | nearby (ערכים ישנים paid_lot / public_street ממופים ל-nearby)
  parkingKind       String?
  parkingLatitude   Float?
  parkingLongitude  Float?
  inquiries         Inquiry[]
  favorites         Favorite[]
  reviews           VenueReview[]
  availabilities    VenueAvailability[]
  galleryImages    VenueGalleryImage[]
  conversations    Conversation[]
  plannedInEvents  EventPlan[] @relation("EventPlanVenue")
  pageViews        VenuePageView[]
  eventPackages    EventPackage[]
  seekerEventBundles SeekerEventBundle[]
  /// קידום בתשלום — עד תאריך זה האולם מוצג בראש תוצאות החיפוש
  boostExpiresAt   DateTime?
  /// מענה אוטומטי לפניות חדשות (אופציונלי)
  autoReplyMessage String?
  /// PENDING | APPROVED | REJECTED — פרסום ציבורי רק לאחר APPROVED
  moderationStatus      String   @default("PENDING")
  moderationNote        String?
  moderatedAt           DateTime?
  moderatedByUserId     Int?
  submittedForReviewAt  DateTime @default(now())
  contentRevision       Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // חיפוש ציבורי (/api/venues): טווחי מספרים; ownerId — דשבורד בעל אולם
  @@index([ownerId])
  @@index([moderationStatus])
  @@index([maxGuests])
  @@index([minPrice])
  @@index([maxPrice])
}

/// צפייה מעורבת בעמוד אולם (אחרי זמן גלוי מינימלי בצד הלקוח) — לפופולריות שבועית
model VenuePageView {
  id        Int      @id @default(autoincrement())
  venueId   Int
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([venueId, createdAt])
}

/// צפייה מעורבת בפרופיל ספק (אחרי זמן גלוי מינימלי) — לפופולריות שבועית
model FreelancerProfileView {
  id             Int      @id @default(autoincrement())
  providerUserId Int
  provider       User     @relation(fields: [providerUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([providerUserId, createdAt])
}

model Inquiry {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  venueId       Int
  venue         Venue    @relation(fields: [venueId], references: [id])
  eventType     String?  // סוג אירוע: חתונה, בר מצווה וכו'
  preferredDate String?  // תאריך משוער
  guestCount    Int?     // כמות אורחים
  message       String
  /// הערות מהמבקש לספקים במאגר (חלופות / ספקים נוספים) — legacy, הודעה אחת
  supplierMessage String?
  /// הערות נפרדות לכל ספק — JSON: [{ serviceId, serviceName, message }]
  supplierMessagesJson String?
  status        String   @default("NEW") // NEW, READ, REPLIED, APPROVED, REJECTED
  ownerNote     String?  // הערה/תשובה מבעל האולם
  repliedAt     DateTime? // מתי סומן כנענה
  /// נשלח מענה מהתבנית האוטומטית של האולם
  autoReplyApplied Boolean @default(false)
  /// בחירות מחפש: לכל שירות שהאולם מציע — דרך האולם או מקור חיצוני (JSON)
  serviceChoicesJson String?
  /// חבילת קטלוג שממנה נגזרה הבקשה (אופציונלי)
  eventPackageId   Int?
  eventPackage     EventPackage? @relation(fields: [eventPackageId], references: [id], onDelete: SetNull)
  /// חבילה אישית של המחפש (אופציונלי)
  seekerBundleId   Int?
  seekerBundle     SeekerEventBundle? @relation(fields: [seekerBundleId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  negotiationThreads NegotiationThread[]
  serviceRequests    ServiceRequest[]

  @@index([userId, venueId])
  @@index([venueId, createdAt])
  @@index([eventPackageId])
  @@index([seekerBundleId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  venueId   Int
  venue     Venue    @relation(fields: [venueId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, venueId])
}

model ServiceFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId Int
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, serviceId])
  @@index([userId])
}

model ContentReport {
  id             Int      @id @default(autoincrement())
  reporterUserId Int?
  reporter       User?    @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)
  targetType     String
  targetId       Int
  reason         String
  details        String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// יומן אישור תוכן (אולמות/שירותים) — מוכן ל־API ואוטומציה עתידית
model ListingModerationEvent {
  id            Int      @id @default(autoincrement())
  listingType   String
  listingId     Int
  action        String
  fromStatus    String?
  toStatus      String
  note          String?
  actorUserId   Int?
  source        String   @default("ADMIN")
  metadataJson  String?
  createdAt     DateTime @default(now())

  @@index([listingType, listingId, createdAt])
  @@index([toStatus, createdAt])
}

model Payment {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId String?  @unique
  stripePaymentId String?
  amountNis       Int
  purpose         String
  venueId         Int?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([userId, createdAt])
  @@index([venueId])
}

model Service {
  id              Int      @id @default(autoincrement())
  providerId      Int
  provider        User     @relation(fields: [providerId], references: [id])
  name            String
  category        String?
  shortDescription String?
  description     String?
  serviceArea     String?
  /// שנות ניסיון בתחום (מספר שלם)
  experienceYears Int?
  /// שפות עבודה, למשל: עברית, אנגלית
  languages       String?
  /// זמן תגובה צפוי ללקוחות (טקסט חופשי)
  responseTimeHint String?
  /// JSON: קישורי רשתות חברתיות לשירות (מערך { platform, url })
  socialLinksJson String?
  includesTravel  Boolean  @default(false)
  includesEquipment Boolean @default(false)
  /// JSON: מערך { label, checked } — תוספות שכלולות במחיר שהפרילנסר הוסיף
  customIncludesJson String?
  /// JSON: תפריט אוכל — קיבולת אורחים, חבילות, מנות ומחירים (קטגוריות «אוכל ומשקאות»)
  menuJson          String?
  /// הסבר קצר למחפשים על מה כלול במחיר (אופציונלי)
  includesNote    String?
  coverImageUrl   String?
  galleryImageUrls String?
  minPrice        Int?
  maxPrice        Int?
  serviceRequests ServiceRequest[]
  negotiationThreads NegotiationThread[]
  conversations   Conversation[]
  plannedAsPhotographer EventPlan[] @relation("EventPlanPhotographer")
  plannedAsDj          EventPlan[] @relation("EventPlanDj")
  plannedAsCatering    EventPlan[] @relation("EventPlanCatering")
  packageLinks    EventPackageService[]
  reviews         ServiceReview[]
  favorites       ServiceFavorite[]
  /// PENDING | APPROVED | REJECTED — פרסום ציבורי רק לאחר APPROVED
  moderationStatus      String   @default("PENDING")
  moderationNote        String?
  moderatedAt           DateTime?
  moderatedByUserId     Int?
  submittedForReviewAt  DateTime @default(now())
  contentRevision       Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // רשימת שירותים לפי ספק; חיפוש ציבורי (/api/services/public)
  @@index([providerId])
  @@index([moderationStatus])
  @@index([category])
  @@index([minPrice])
  @@index([maxPrice])
  @@index([createdAt])
}

/// חבילת אירוע: אולם + שירותים (סגנון "טיסה+מלון" – הכל במקום אחד)
model EventPackage {
  id               Int                   @id @default(autoincrement())
  title            String
  subtitle         String?
  description      String?
  venueId          Int
  venue            Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// מחיר חבילה משוער (הצגה בלבד) – ₪
  bundlePriceFrom  Int?
  bundlePriceTo    Int?
  /// תווית קטנה לכרטיס, למשל: "חיסכון" / "מובילים"
  badgeLabel       String?
  /// basic | standard | premium
  tier             String?
  /// JSON: מערך סוגי אירוע
  eventTypesJson   String?
  guestMin         Int?
  guestMax         Int?
  /// JSON: [{ venueOptionId }] — פריטי אולם כלולים בחבילה
  venueIncludesJson String?
  /// JSON: [{ role, mode, serviceId?, allowAlternatives? }]
  serviceSlotsJson String?
  isPublished      Boolean               @default(true)
  sortOrder        Int                   @default(0)
  services         EventPackageService[]
  inquiries        Inquiry[]
  sourceBundles    SeekerEventBundle[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([isPublished, sortOrder])
  @@index([venueId])
}

model EventPackageService {
  id        Int          @id @default(autoincrement())
  packageId Int
  package   EventPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId Int
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@index([serviceId])
}

/// חבילת אירוע אישית למחפש — אולם + שירותים (ידני או שנבנה אוטומטית)
model SeekerEventBundle {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  eventType   String
  eventDate   String?
  guestCount  Int?
  area        String?
  budgetMin   Int?
  budgetMax   Int?
  venueId     Int?
  venue       Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  /// manual | auto
  buildMode   String   @default("manual")
  /// draft | ready | submitted
  status      String   @default("draft")
  /// נגזר מתבנית EventPackage (אופציונלי)
  sourcePackageId Int?
  sourcePackage   EventPackage? @relation(fields: [sourcePackageId], references: [id], onDelete: SetNull)
  /// JSON: SeekerBundleItem[]
  itemsJson   String   @default("[]")
  inquiries   Inquiry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([venueId])
}

model EventPlan {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType          String   // חתונה | בר מצווה
  title              String?
  eventDate          String?
  area               String?
  budgetMin          Int?
  budgetMax          Int?
  checklistJson      String? // JSON: { venue, photographer, dj, catering }
  venueId            Int?
  venue              Venue?   @relation("EventPlanVenue", fields: [venueId], references: [id], onDelete: SetNull)
  photographerServiceId Int?
  photographerService   Service? @relation("EventPlanPhotographer", fields: [photographerServiceId], references: [id], onDelete: SetNull)
  djServiceId        Int?
  djService          Service? @relation("EventPlanDj", fields: [djServiceId], references: [id], onDelete: SetNull)
  cateringServiceId  Int?
  cateringService    Service? @relation("EventPlanCatering", fields: [cateringServiceId], references: [id], onDelete: SetNull)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model Conversation {
  id             Int       @id @default(autoincrement())
  participant1Id Int
  participant1   User      @relation("ConvP1", fields: [participant1Id], references: [id])
  participant2Id Int
  participant2   User      @relation("ConvP2", fields: [participant2Id], references: [id])
  contextKey     String
  venueId        Int?
  venue          Venue?    @relation(fields: [venueId], references: [id])
  serviceId      Int?
  service        Service?  @relation(fields: [serviceId], references: [id])
  messages       Message[]
  negotiationThread NegotiationThread?
  participant1LastReadAt DateTime?
  participant2LastReadAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([participant1Id, participant2Id, contextKey])
  @@index([participant1Id])
  @@index([participant2Id])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ServiceRequest {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  serviceId    Int
  service      Service  @relation(fields: [serviceId], references: [id])
  inquiryId    Int?
  inquiry      Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  eventType    String?
  preferredDate String?
  /// מספר אורחים — חובה לבקשות לשירותי אוכל/קייטרינג
  guestCount   Int?
  message      String
  status       String   @default("NEW") // NEW, READ, REPLIED
  providerNote String?
  repliedAt    DateTime?
  createdAt    DateTime @default(now())

  negotiationThread NegotiationThread?

  @@index([inquiryId])
  @@index([userId, createdAt])
}

model NegotiationThread {
  id               Int      @id @default(autoincrement())
  inquiryId        Int
  inquiry          Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  kind             String   // VENUE | SUPPLIER
  threadKey        String   // venue | service:{serviceId}
  serviceId        Int?
  service          Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceRequestId Int?     @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  conversationId   Int      @unique
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status           String   @default("OPEN") // OPEN | DEAL_ACCEPTED | CLOSED
  offers           NegotiationOffer[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([inquiryId, threadKey])
  @@index([inquiryId])
}

model NegotiationOffer {
  id                Int      @id @default(autoincrement())
  threadId          Int
  thread            NegotiationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId      Int
  author            User     @relation(fields: [authorUserId], references: [id])
  authorRole        String   // SEEKER | VENUE_OWNER | FREELANCER
  amountMinNis      Int?
  amountMaxNis      Int?
  message           String?
  status            String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | WITHDRAWN | SUPERSEDED
  respondsToOfferId Int?
  respondsToOffer   NegotiationOffer?  @relation("OfferResponse", fields: [respondsToOfferId], references: [id], onDelete: SetNull)
  responses         NegotiationOffer[] @relation("OfferResponse")
  createdAt         DateTime @default(now())

  @@index([threadId, createdAt])
}

model VenueReview {
  id        Int      @id @default(autoincrement())
  venueId   Int
  venue     Venue   @relation(fields: [venueId], references: [id])
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  /// דירוג בשלבים של ½ כוכב, נשמר כמספר שלם 2–10 (×2) — SQLite לא מקצר עשרוניים
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model ServiceReview {
  id        Int      @id @default(autoincrement())
  serviceId Int
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, serviceId])
  @@index([serviceId])
}

model VenueAvailability {
  id        Int      @id @default(autoincrement())
  venueId   Int
  venue     Venue   @relation(fields: [venueId], references: [id])
  date      DateTime
  status    String  // "FREE" או "BOOKED"
  createdAt DateTime @default(now())

  @@unique([venueId, date])
}

model VenueGalleryImage {
  id        Int                @id @default(autoincrement())
  venueId   Int
  venue     Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  url       String
  // ערכים אפשריים: "HALL", "CHUPPA", "OTHER", "FOOD" (DANCE — legacy, מוצג כ«אחר»)
  category  String
  createdAt DateTime          @default(now())

  @@index([venueId, category])
}

/// תור משימות רקע (מעובד ע״י /api/cron/process-jobs + Vercel Cron)
model BackgroundJob {
  id          Int       @id @default(autoincrement())
  /// מזהה סוג (מטופל ב־jobHandlers)
  type        String
  /// JSON — מטען למטפל
  payloadJson String?
  status      String    @default("PENDING") // PENDING, PROCESSING, DONE, FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  runAfter    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([status, runAfter])
}

# Copy to ".env" for local development. Never commit .env or paste real secrets into app code.
# העתק ל-.env — אל תעלה את .env ל-Git ואל תשים סיסמאות בקבצי קוד.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
JWT_SECRET="use-a-long-random-string-32-chars-min-on-vercel"

# פרודקשן (Vercel): אותו ערך כמו במשתני הסביבה שם. URL: https://<דומיין>/api/webhooks/inbound
# WEBHOOK_INBOUND_SECRET=long-random-string-min-32-chars

# אימיילים של אדמין (מופרדים בפסיק) — רק הם רואים "החלף משתמש" ו־API ‎/api/dev/*
# ADMIN_EMAILS=you@example.com

# באוויר: לאפשר החלפת משתמש גם בפרודקשן (רק עם ADMIN_EMAILS). ברירת מחדל: כבוי
# ALLOW_DEV_USER_SWITCH=true

# Rate limiting (Edge) — Upstash Redis חינמי: https://console.upstash.com/
# בלי שני המשתנים, /api לא מוגבל ברמת הקוד (Vercel/Cloudflare עדיין מגנים ברשת)
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."

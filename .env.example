# Copy to ".env" for local development. Never commit .env or paste real secrets into app code.
# העתק ל-.env — אל תעלה את .env ל-Git ואל תשים סיסמאות בקבצי קוד.
# אסור להשתמש ב־NEXT_PUBLIC_* ל־DATABASE_URL / JWT / מפתחות API — הם ייחשפו בדפדפן.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
JWT_SECRET="use-a-long-random-string-32-chars-min-on-vercel"

# פרודקשן (Vercel): אותו ערך כמו במשתני הסביבה שם. URL: https://<דומיין>/api/webhooks/inbound
# WEBHOOK_INBOUND_SECRET=long-random-string-min-32-chars

# אימיילים של אדמין (מופרדים בפסיק) — רק הם רואים "החלף משתמש" ו־API ‎/api/dev/*
# ADMIN_EMAILS=you@example.com

# באוויר: לאפשר החלפת משתמש גם בפרודקשן (רק עם ADMIN_EMAILS). ברירת מחדל: כבוי
# ALLOW_DEV_USER_SWITCH=true

# Rate limiting (Edge) — Upstash Redis חינמי: https://console.upstash.com/
# בלי שני המשתנים, /api לא מוגבל ברמת הקוד (Vercel/Cloudflare עדיין מגנים ברשת)
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."

# Sentry — ניטור שגיאות וביצועים (ה-DSN ציבורי בכוונה; לא סוד)
# https://sentry.io — צור פרויקט Next.js והעתק DSN
# NEXT_PUBLIC_SENTRY_DSN="https://....@....ingest....sentry.io/..."
# אופציונלי: SENTRY_AUTH_TOKEN (ב-Vercel בלבד) להעלאת source maps בבילד — מ-Organization Settings → Auth Tokens

# תור משימות (BackgroundJob) — Vercel Cron קורא ל־/api/cron/process-jobs
# יצור מחרוזת אקראית והגדר ב-Vercel; ב-Cron יישלח Authorization: Bearer <CRON_SECRET>
# CRON_SECRET="long-random-string-min-32-chars"

# העלאת תמונות בפרודקשן (Vercel) — Vercel Blob: https://vercel.com/storage/blob
# נדרש לתמונות שער/גלריה של אולמות ושירותי פרילנסר. בלי המשתנה, ב-Vercel ייכשל אחסון תמונות.
# Vercel → Storage → Blob → "Connect to Project" יקבע את המשתנה אוטומטית.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# שליחת מיילים (Resend) — חינמי עד 3000 מיילים/חודש: https://resend.com
# נדרש כדי ש"שכחתי סיסמה" באמת ישלח מייל למשתמש.
# 1) פתח חשבון ב-Resend, צור API Key (Full access), והדבק כאן.
# 2) EMAIL_FROM אופציונלי — ברירת מחדל: onboarding@resend.dev (מאומת לבדיקות).
#    לפרודקשן רצינית כדאי לאמת דומיין משלך ב-Resend Dashboard → Domains.
#    בלי EMAIL_FROM מאומת — resend.dev שולח רק לכתובת חשבון Resend (לא לכל משתמש).
# ALLOW_EMAIL_VERIFY_CODE_FALLBACK=true  # אופציונלי: הצג קוד בדף כששליחת מייל נכשלת
# DISABLE_EMAIL_VERIFICATION=true  # זמני: הרשמה/התחברות בלי קוד במייל (עד שיש דומיין מאומת)
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="Halls Hub <noreply@yourdomain.com>"

# Forgot/Reset password — webhook נוסף/חלופי (אופציונלי). נשלח אחרי הניסיון של Resend.
# Payload: { event:"password_reset_requested", userId, email, name, resetUrl, expiresAt, sentAt }
# PASSWORD_RESET_WEBHOOK_URL="https://your-mailer/webhook"

# גיאוקוד — גיבוי Google (אופציונלי). ברירת מחדל: ArcGIS ללא מפתח.
# GOOGLE_GEOCODING_API_KEY="AIza..."

# קידום אולם בדשבורד — דמו בלבד (ללא סליקה). בפרוד רגיל השאר ריק.
# VENUE_BOOST_ALLOW_DEMO=true

# פרטי עסק (footer + דפים משפטיים). בלי env — eventforyou077@gmail.com
# SITE_LEGAL_NAME="EventForYou"
# SITE_SUPPORT_EMAIL="eventforyou077@gmail.com"
# SITE_PRIVACY_EMAIL="eventforyou077@gmail.com"
# SITE_ACCESSIBILITY_EMAIL="eventforyou077@gmail.com"
# SITE_CONTACT_ADDRESS="ישראל"

# Cloudflare Turnstile (CAPTCHA) — https://dash.cloudflare.com/
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="..."
# TURNSTILE_SECRET_KEY="..."

# Stripe (שלב 7 — סליקה Boost, אחרון)
# STRIPE_SECRET_KEY="sk_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."
